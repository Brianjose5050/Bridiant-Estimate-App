{
  "name": "bridiant-facility-group-platform",
  "version": "0.1.0",
  "private": true,
  "description": "Bridiant Facility Group bilingual public website and private owner admin (development workspace).",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "typecheck": "tsc -b",
    "test": "vitest run",
    "check:palette": "node scripts/palette-check.mjs",
    "check": "npm run typecheck && npm run check:palette && npm test",
    "build:preview": "npm run build:preview -w @bridiant/public",
    "build:production": "npm run build:production -w @bridiant/public",
    "check:public": "npm run check:build -w @bridiant/public"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "vitest": "^3.2.0"
  }
}
