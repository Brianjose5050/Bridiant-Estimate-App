---
import Base from '../../../layouts/Base.astro';
import PageHero from '../../../components/PageHero.astro';
import Tag from '../../../components/Tag.astro';
import { LANGS, MODE, pages, ready, text, ui, type Lang } from '../../../lib/site';

export function getStaticPaths() {
  return LANGS.filter((lang) => ready(lang, ['work.intro', 'work.emptyState'])).map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: Lang };
const intro = text('work.intro', lang);
const emptyState = text('work.emptyState', lang) ?? '';
---
<Base lang={lang} title={`${ui('nav.ourWork', lang)} · Bridiant Facility Group`} description={intro ?? ''} page={pages.work}>
  <PageHero eyebrow={lang === 'en' ? 'Projects' : 'Proyectos'} title={ui('nav.ourWork', lang)} lead={intro ?? undefined} />
  <section class="section" style="padding-top:0">
    <div class="wrap" style="display:grid;gap:32px">
      {MODE === 'preview' && <Tag lang={lang} />}
      <p class="empty" id="gallery-empty">{emptyState}</p>
      <div id="gallery-live" data-lang={lang}></div>
    </div>
  </section>
  <script>
    import { initGallery } from '../../../client/gallery';
    initGallery();
  </script>
</Base>
