---
import Base from '../../../layouts/Base.astro';
import PageHero from '../../../components/PageHero.astro';
import { LANGS, pages, ready, text, ui, type Lang } from '../../../lib/site';

export function getStaticPaths() {
  return LANGS.filter((lang) => ready(lang, ['thanks.title', 'thanks.next', 'thanks.note'])).map((lang) => ({ params: { lang } }));
}
const { lang } = Astro.params as { lang: Lang };
const title = text('thanks.title', lang);
const next = text('thanks.next', lang);
const note = text('thanks.note', lang);
const welcomeTitle = text('thanks.welcomeTitle', lang);
const welcomeLead = text('thanks.welcomeLead', lang);
const welcomeCta = text('thanks.welcomeCta', lang);
const refLabel = lang === 'en' ? 'Your reference' : 'Su referencia';
---
<Base lang={lang} title={`${ui('nav.requestEstimate', lang)} · Bridiant Facility Group`} description={title ?? ''} page={`${pages.request}thanks/`} showMobileBar={false}>
  <PageHero eyebrow={ui('nav.requestEstimate', lang)} title={title ?? ''} lead={next ?? undefined} />
  <section class="section" style="padding-top:0">
    <div class="wrap" style="display:grid;gap:24px;max-width:720px">
      <div class="status" data-reference-box hidden>
        <span class="eyebrow" style="margin:0">{refLabel}</span>
        <strong data-reference style="font-size:1.6rem;letter-spacing:0.04em"></strong>
        {note && <p>{note}</p>}
      </div>
      <p class="help">{lang === 'en' ? 'Photos can be sent by replying to your confirmation email or by calling us.' : 'Puede enviar fotos respondiendo a su correo de confirmación o llamándonos.'}</p>

      {welcomeTitle && welcomeCta && (
        <section class="invite reveal" aria-labelledby="invite-title">
          <span class="eyebrow" style="margin:0">Bridiant</span>
          <h2 id="invite-title" class="serif">{welcomeTitle}</h2>
          {welcomeLead && <p class="lead" style="font-size:1rem">{welcomeLead}</p>}
          <a class="btn btn--primary invite__cta" href={`/${lang}/welcome/`}>{welcomeCta} →</a>
        </section>
      )}

      <div class="actions">
        <a class="btn btn--ghost" href={`/${lang}/services/`}>{ui('nav.services', lang)}</a>
      </div>
    </div>
  </section>
</Base>
<script>
  import { initThanks } from '../../../client/thanks';
  initThanks();
</script>
